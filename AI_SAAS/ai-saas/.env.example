NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# NVIDIA NIM — get your API key at https://build.nvidia.com/
NVIDIA_API_KEY=
# Model for chat/conversation (defaults to deepseek-ai/deepseek-v4-pro)
NVIDIA_CHAT_MODEL=deepseek-ai/deepseek-v4-pro
# Model for code generation (defaults to deepseek-ai/deepseek-v4-pro)
NVIDIA_CODE_MODEL=deepseek-ai/deepseek-v4-pro

# OpenRouter — free-tier fallback when NVIDIA is overloaded. Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free models (verified working on OpenRouter free tier)
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_CODE_MODEL=cohere/north-mini-code:free

# Optional: only needed for Music + Video generation via Replicate
REPLICATE_API_TOKEN=

DATABASE_URL=
DIRECT_URL=

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CRISP_WEBSITE_ID=
